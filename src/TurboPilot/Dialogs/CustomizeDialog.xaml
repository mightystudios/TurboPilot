<ctl:TurbolandFloatingDialog
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
	xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
	x:Class="TurboPilot.Dialogs.CustomizeDialog"
	Title="Customization" Width="960" Height="493">

    <ctl:TurbolandFloatingDialog.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- One row of a found-items list: the checkmark is the only hit
        target for toggling, so the name sits in its own TextBlock and a
        click there just selects the row for the details pane. -->
        <DataTemplate x:Key="FoundItemTemplate">
            <StackPanel Orientation="Horizontal">
            	<CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
            	<TextBlock Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="Built in" Margin="8,0,0,0" VerticalAlignment="Center"
                    Opacity="0.7"
                    Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </ctl:TurbolandFloatingDialog.Resources>

    <!-- Edit the list of folders the application searches for
	customization items. The floating dialog sizes to its content, which
	overrides Width and Height at runtime; the designer's Width/Height
	are captured as MinWidth/MinHeight in OnInitialized, so they act as
	the minimum dialog size. The found-items tabs list the collected
	customization items with enable checkboxes and a details pane; Add
	To Prompt is a placeholder until item management. -->
    <StackPanel Margin="10,0,10,0">
        <Label Content="Additional Search Paths (TurboPilot built-ins, user folder, and workspace are automatic)"/>

        <!-- Folder list with its side button column. -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="listBox" Grid.Column="0" Height="112"
					SelectionMode="Single"
					SelectionChanged="OnListSelectionChanged"
					Margin="{DynamicResource Turboland.Size.ColumnGutter}"/>

            <StackPanel Grid.Column="1" Width="96">
                <Button x:Name="buttonAdd" Content="Add" Click="OnAdd"
						Margin="0,0,0,6"/>
                <Button x:Name="buttonDelete" Content="Delete" Click="OnDelete"/>
            </StackPanel>
        </Grid>

        <!-- Items collected from the search roots, one tab per type. The
        checkmark toggles participation; selecting a row shows its details.
        Add To Prompt stages a mention of the selected item for the prompt
        box, discarded with the rest of the dialog on Cancel. -->
        <Grid Margin="0,12,0,0" Height="250">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="tabsFound" Grid.Column="0"
					Margin="0,10,0,10">
                <TabItem x:Name="tabPrompts" Header="Prompts">
                    <ListBox x:Name="listPrompts"
							ItemTemplate="{StaticResource FoundItemTemplate}"
							SelectionChanged="OnFoundItemSelected"
							CheckBox.Checked="OnItemToggled" CheckBox.Unchecked="OnItemToggled"/>
                </TabItem>
                <TabItem x:Name="tabAgents" Header="Agents">
                    <ListBox x:Name="listAgents"
							ItemTemplate="{StaticResource FoundItemTemplate}"
							SelectionChanged="OnFoundItemSelected"
							CheckBox.Checked="OnItemToggled" CheckBox.Unchecked="OnItemToggled"/>
                </TabItem>
                <TabItem x:Name="tabSkills" Header="Skills">
                    <ListBox x:Name="listSkills"
							ItemTemplate="{StaticResource FoundItemTemplate}"
							SelectionChanged="OnFoundItemSelected"
							CheckBox.Checked="OnItemToggled" CheckBox.Unchecked="OnItemToggled"/>
                </TabItem>
                <TabItem x:Name="tabInstructions" Header="Instructions">
                    <ListBox x:Name="listInstructions"
							ItemTemplate="{StaticResource FoundItemTemplate}"
							SelectionChanged="OnFoundItemSelected"
							CheckBox.Checked="OnItemToggled" CheckBox.Unchecked="OnItemToggled"/>
                </TabItem>
                <TabItem x:Name="tabMcpServers" Header="MCP Servers">
                    <ListBox x:Name="listMcpServers"
							ItemTemplate="{StaticResource FoundItemTemplate}"
							SelectionChanged="OnFoundItemSelected"
							CheckBox.Checked="OnItemToggled" CheckBox.Unchecked="OnItemToggled"/>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <Label Content="Item Details"/>
                <TextBox x:Name="textBoxDetails" Height="213" TextWrapping="Wrap"
						IsReadOnly="True" VerticalScrollBarVisibility="Auto" MaxWidth="495" Width="495" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,59,0">
                <RadioButton x:Name="radioOnlyEnabled" Content="Only Show Enabled"
                		VerticalAlignment="Center"
                		PreviewMouseLeftButtonDown="OnOnlyEnabledBeforeToggle"
                		PreviewKeyDown="OnOnlyEnabledBeforeToggle"
                		Click="OnOnlyEnabledClick"
                		Checked="OnOnlyEnabledChanged" Unchecked="OnOnlyEnabledChanged"/>
                <Button x:Name="buttonAddToPrompt" Content="Add To Prompt" Width="149" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnAddToPrompt"/>
                <!-- Save/Load carry only the item enabled options, not the
                folder list: those are application-level globals. -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="buttonSaveOptions" Content="Save Options..." Width="170"
							Click="OnSaveOptions" Margin="0,0,12,0"/>
                    <Button x:Name="buttonLoadOptions" Content="Load Options..." Width="170"
							Click="OnLoadOptions"/>
                </StackPanel>
            </StackPanel>
            <!-- ButtonStripMargin keeps each button's hard shadow off its
			neighbor; the rightmost button needs none. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="buttonCancel" Content="Cancel" Width="100" IsCancel="True" Click="OnCancel" Margin="0,0,12,0"/>
                <Button x:Name="buttonOK" Content="OK" Width="100" IsDefault="True" Click="OnOk"
						Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</ctl:TurbolandFloatingDialog>
