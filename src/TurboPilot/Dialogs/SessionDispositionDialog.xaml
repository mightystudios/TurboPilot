<ctl:TurbolandFloatingDialog x:Class="TurboPilot.Dialogs.SessionDispositionDialog"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					Title="End Session">

	<ctl:TurbolandFloatingDialog.Resources>
		<SolidColorBrush x:Key="DangerFace" Color="{DynamicResource Turboland.Color.Palette.4}"/>
		<SolidColorBrush x:Key="DangerInk" Color="{DynamicResource Turboland.Color.Palette.15}"/>
		<Style x:Key="DangerButton" TargetType="Button"
			   BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Background" Value="{StaticResource DangerFace}"/>
			<Setter Property="Foreground" Value="{StaticResource DangerInk}"/>
		</Style>
	</ctl:TurbolandFloatingDialog.Resources>

	<StackPanel>
		<TextBlock x:Name="Message" TextWrapping="Wrap"
					MinWidth="360" MaxWidth="540"
					Margin="0,0,0,18"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
			<Button x:Name="buttonStore" Content="Summarize and Store"
					IsDefault="True" Click="OnStore"
					Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
			<Button x:Name="buttonAbandon" Content="Abandon"
					Click="OnAbandon" Style="{StaticResource DangerButton}"
					Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
			<Button x:Name="buttonCancel" Content="Cancel"
					IsCancel="True" Click="OnCancel"
					Margin="{DynamicResource Turboland.Size.ButtonStripMargin}"/>
		</StackPanel>
	</StackPanel>
</ctl:TurbolandFloatingDialog>
