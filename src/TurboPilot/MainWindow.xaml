<ctl:TurbolandWindow
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:ctl="clr-namespace:TurbolandTheme.Wpf.Controls;assembly=TurbolandTheme.Wpf"
					xmlns:local="clr-namespace:TurboPilot"
					xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
					xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="TurboPilot.MainWindow"
					Title="TURBO-PILOT"
					Closing="OnWindowClosing"
					WindowStartupLocation="CenterScreen"
					Width="800" Height="960"
					av:DesignWidth="800" av:DesignHeight="960">

    <ctl:TurbolandWindow.Resources>
        <!-- Arrow cell for the prompt history gutter. The stock theme button
		     is a green push button at least ButtonMinWidth (72px) wide with a
		     one-cell shadow offset, neither of which survives being clipped to
		     a 24px strip: the label is centered outside the visible area and
		     the shadow covers most of the face. This is the scroll bar arrow
		     instead, one cell tall and as wide as the strip gives it. The
		     triangles are CP437 glyphs present in the bundled face, written as
		     character references so the source stays ASCII. -->
        <Style x:Key="HistoryArrowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="{DynamicResource Turboland.Metric.CellHeight}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Turboland.Font.Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource Turboland.Font.Size.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.ScrollTrackStipple}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="face" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Turboland.Brush.ControlSelected}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource Turboland.Brush.ControlShadow}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.ControlSelectedForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Turboland.Brush.DisabledForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ctl:TurbolandWindow.Resources>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Session">
                <!-- One entry for the whole session lifecycle. It opens the
                     settings dialog either way; the caption says whether
                     accepting would start a session or change the running
                     one. Permissions and Customization open from inside
                     that dialog, so they need no menu entry of their own. -->
                <MenuItem x:Name="menuNewSession" Header="_Begin Session..." Click="OnNewSession"/>
                <MenuItem x:Name="menuPastSessions" Header="_Past Sessions..." Click="OnPastSessions"/>
                <MenuItem x:Name="menuSessionDetails" Header="Session _Details" Click="OnSessionDetails"/>
                <Separator/>
                <!-- Saves what is on screen, not a re-render: the HTML is
                     the live Rendered document with its styling inlined, so
                     a saved page reads the same as the tab it came from. -->
                <MenuItem x:Name="menuSaveTranscript" Header="Sa_ve Transcript..." Click="OnSaveTranscript"/>
                <Separator/>
                <MenuItem x:Name="menuCompactContext" Header="_Compact Context" Click="OnCompactContext"/>
                <MenuItem x:Name="menuResetContext" Header="_Reset Context" Click="OnResetContext"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem x:Name="menuTools" Header="_Tools">
                <MenuItem x:Name="menuOpenPowershell" Header="Open _Powershell" Click="OnOpenPowerShell"/>
                <MenuItem x:Name="menuOpenExplorer" Header="Open _Explorer" Click="OnOpenExplorer"/>
                <MenuItem x:Name="menuOpenVsCode" Header="Open _VSCode" Click="OnOpenVsCode"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="menuShowHelp" Header="Show _Help" Click="OnShowHelp"/>
                <Separator/>
                <MenuItem Header="_About..." Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <StatusBar x:Name="statusBar" DockPanel.Dock="Bottom" Height="43">
            <!-- StatusBar uses a DockPanel. Reserve the button strip first,
                 then let the final item fill only the width that remains. -->
            <StatusBarItem x:Name="statusButtonsItem" DockPanel.Dock="Right">
                <StackPanel x:Name="statusButtons" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                    <!-- Session-dependent controls: enabled and disabled in bulk
                         by SetSessionActive, not here. No explicit colors: local
                         values would outrank the theme's disabled-state triggers
                         and leave a disabled button painted in its enabled ink. -->
                    <Button x:Name="buttonAttachments" Content="+0" Width="40" Height="25" Margin="0,0,5,0"
							ToolTip="manage attachments" Click="ButtonAttachments_Click"/>
                    <Button x:Name="buttonStop" Content="Stop" Width="60" Height="25" Margin="0,0,5,0" Click="ButtonStop_Click"/>
                    <Button x:Name="buttonSend" Content="Send" Width="80" Height="25" Click="ButtonSend_Click"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem x:Name="statusBarItem" MinWidth="0" HorizontalContentAlignment="Stretch">
                <Grid x:Name="statusTextViewport" ClipToBounds="True"
                      SizeChanged="StatusText_SizeChanged">
                    <TextBlock x:Name="statusTextBlock"
                               Text="Start or resume a session to begin."
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               SizeChanged="StatusText_SizeChanged">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="statusTextTransform"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- The blue desktop. The dialog host is a sibling laid over the content
		     in the same grid cell, so dialogs float above the output but never
		     over the menu or status bar. It is invisible and click-through
		     until a dialog is actually opened. -->
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <!-- Output tabs: takes remaining space, shrinks/grows with splitter -->
                <RowDefinition x:Name="OutputRow" Height="*"/>
                <!-- Horizontal splitter bar: draggable, minimum 4px -->
                <RowDefinition Height="4"/>
                <!-- Prompt input area: takes remaining space, shrinks/grows with splitter -->
                <RowDefinition x:Name="InputRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- Output tabs at the top (Rendered and Raw) -->
            <Grid x:Name="modelOutputGrid" Grid.Row="0" Margin="4,2,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label x:Name="labelModelOutput" Grid.Row="0"
						Content="Model Output" Target="{Binding ElementName=outputTabs}"
						Foreground="{Binding Foreground, ElementName=richTextBoxOutput}"/>

                <!-- No Style key: use the theme's implicit tab styles. -->
                <TabControl x:Name="outputTabs" Grid.Row="1" Padding="2">
                    <TabItem Header="Rendered">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="197*"/>
                                <ColumnDefinition Width="589*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Face color is set in code from the theme table. -->
                            <wv2:WebView2 x:Name="webViewOutput" Grid.ColumnSpan="2" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="Raw">
                        <!-- Face and ink come from the theme table in code so the
                             Raw tab can never drift from the Rendered tab. -->
                        <RichTextBox x:Name="richTextBoxOutput"
									FontFamily="{DynamicResource Turboland.Font.Primary}"
									FontSize="16"
									VerticalScrollBarVisibility="Auto"
									HorizontalScrollBarVisibility="Auto"
									IsReadOnly="True">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Horizontal resizing splitter bar (draggable Thumb) -->
            <Thumb Grid.Row="1" 
				   x:Name="SplitterThumb"
				   Cursor="SizeNS"
				   Background="#565656"
				   DragDelta="SplitterThumb_DragDelta"/>

            <!-- Prompt input area at the bottom -->
            <Grid x:Name="promptInputGrid" Grid.Row="2" Margin="4,2,4,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="labelUserPrompt" Grid.Row="0" Grid.ColumnSpan="2"
						Content="User Prompt" Target="{Binding ElementName=richTextBoxInput}"
						Foreground="{Binding Foreground, ElementName=richTextBoxInput}"/>

                <!-- Prompt history gutter: the older prompt is one cell up,
                     the newer one a cell down, pinned to the ends of the
                     strip so the empty middle reads as furniture rather than
                     as two buttons that lost their labels. -->
                <Border Grid.Row="1" Background="{DynamicResource Turboland.Brush.ControlFace}"
                        BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="buttonHistoryPrev" Grid.Row="0"
                                Style="{StaticResource HistoryArrowButton}"
                                Content="&#x25B2;"
                                ToolTip="Older prompt"
                                Click="ButtonHistoryPrev_Click"/>
                        <Button x:Name="buttonHistoryNext" Grid.Row="2"
                                Style="{StaticResource HistoryArrowButton}"
                                Content="&#x25BC;"
                                ToolTip="Newer prompt"
                                Click="ButtonHistoryNext_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PromptTextRow" Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ImagePreviewRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <RichTextBox x:Name="richTextBoxInput" 
								Background="{DynamicResource Turboland.Brush.DesktopBackground}" 
								Foreground="Yellow" 
								FontFamily="{DynamicResource Turboland.Font.Primary}" 
								FontSize="16" 
								VerticalScrollBarVisibility="Auto" 
								HorizontalScrollBarVisibility="Auto" 
								IsReadOnly="True"
								AcceptsTab="True" 
								AcceptsReturn="True"
								AllowDrop="True"
								PreviewDragEnter="Input_PreviewDragOver"
								PreviewDragOver="Input_PreviewDragOver"
								PreviewDrop="Input_PreviewDrop">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                    <Thumb x:Name="imagePreviewSplitter" Grid.Row="1"
							Height="4"
							Visibility="Collapsed"
							Cursor="SizeNS"
							Background="#565656"
							ToolTip="Resize image previews"
							DragDelta="ImagePreviewSplitter_DragDelta"/>
					<ScrollViewer x:Name="imagePreviewScroll" Grid.Row="2"
							Visibility="Collapsed"
							HorizontalScrollBarVisibility="Auto"
							VerticalScrollBarVisibility="Disabled"
							SizeChanged="ImagePreviewScroll_SizeChanged">
						<StackPanel x:Name="imagePreviewPanel" Orientation="Horizontal"/>
					</ScrollViewer>
                    <TextBlock x:Name="noticeTextBlock" Grid.Row="3" Margin="4,4,4,0"
							TextWrapping="Wrap" MaxHeight="68" Visibility="Collapsed"
							Foreground="{DynamicResource Turboland.Brush.WindowForeground}"/>
                    <!-- Prompt completion. The prompt box is at the bottom of
                         the window, so the list opens upward over the output
                         rather than off the bottom of the screen. It is a
                         popup and not a pane: nothing about it can widen the
                         window. -->
                    <Popup x:Name="commandPopup" Placement="Top" StaysOpen="True"
							Focusable="False" AllowsTransparency="False"
							PlacementTarget="{Binding ElementName=richTextBoxInput}">
                        <Border Background="{DynamicResource Turboland.Brush.ControlFace}"
								BorderBrush="{DynamicResource Turboland.Brush.ControlShadow}"
								BorderThickness="1">
                            <ListBox x:Name="commandList" Width="520" MaxHeight="176"
									Focusable="False" BorderThickness="0"
									ScrollViewer.HorizontalScrollBarVisibility="Disabled"
									PreviewMouseLeftButtonDown="CommandList_PreviewMouseLeftButtonDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Width="160"/>
                                            <TextBlock Text="{Binding Summary}" Width="344"
														TextTrimming="CharacterEllipsis"
														ToolTip="{Binding Summary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
            <!-- Live session badge over the output area: model and session id
                 while a session runs, a notice when none does. Right-aligned;
                 the left margin keeps it clear of the tab headers. -->
            <TextBlock x:Name="sessionInfo" HorizontalAlignment="Right" TextAlignment="Right"
						Margin="0,10,8,0" TextWrapping="Wrap" VerticalAlignment="Top"
						Text="No session active" Width="552" Height="33"/>
        </Grid>

    </DockPanel>

</ctl:TurbolandWindow>
