<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>TurboPilot</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Version>1.0.0-alpha.1</Version>
	</PropertyGroup>

	<PropertyGroup>
		<!-- The Copilot SDK package downloads a large CLI binary and runs tar during
		     the build. The XAML designer's design-time build runs in a separate host
		     where that download can fail, which breaks reference resolution and shows
		     "Some assembly references are missing". The designer never runs the app,
		     so skip the CLI download for design-time builds only. -->
		<CopilotSkipCliDownload Condition="'$(DesignTimeBuild)' == 'true'">true</CopilotSkipCliDownload>
		<ApplicationIcon>turbo_icon.ico</ApplicationIcon>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<!-- UseWindowsForms injects an implicit `using System.Windows.Forms` which
		     collides with WPF's System.Windows.Controls (ListBox, TextBox, Button).
		     Remove it; WinForms types are referenced by full qualification where needed. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="GitHub.Copilot.SDK" Version="1.0.26" />
		<PackageReference Include="OpenAI" Version="2.13.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\submodules\turboland-wpf\src\TurbolandTheme.Wpf\TurbolandTheme.Wpf.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Bundled web assets for the Rendered output tab. -->
		<None Include="web\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

		<!-- Sample transcript shown in both output views at startup. -->
		<None Include="Assets\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Assets\session-launch-capabilities.json">
			<TargetPath>session-launch-capabilities.json</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>

		<!-- Application-owned phase workflow customizations. Keep this
		     allowlist explicit so tests and generated Python files never
		     enter the runtime bundle. -->
		<None Include="..\..\SessionTools\README.md">
			<Link>SessionTools\README.md</Link>
			<TargetPath>SessionTools\README.md</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\..\SessionTools\agents\**\*">
			<Link>SessionTools\agents\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>SessionTools\agents\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\..\SessionTools\contracts\**\*">
			<Link>SessionTools\contracts\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>SessionTools\contracts\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\..\SessionTools\skills\**\*">
			<Link>SessionTools\skills\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>SessionTools\skills\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Include="..\..\SessionTools\src\**\*.py">
			<Link>SessionTools\src\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<TargetPath>SessionTools\src\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="turbo_icon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

</Project>
