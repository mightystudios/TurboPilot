{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "TurboPilot Session Launch Request",
	"description": "Native TurboPilot 1.0 launch request used for one managed phase session.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contractVersion",
		"launchId",
		"sessionLabel",
		"workspace",
		"attachments",
		"initialPrompt",
		"mode",
		"sessionStatusPath",
		"sessionControlPath"
	],
	"properties": {
		"contractVersion": {
			"const": "1.0"
		},
		"launchId": {
			"type": "string",
			"minLength": 1
		},
		"sessionLabel": {
			"type": "string",
			"minLength": 1
		},
		"workspace": {
			"type": "string",
			"minLength": 1
		},
		"attachments": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"initialPrompt": {
			"type": "string",
			"minLength": 1
		},
		"mode": {
			"type": "string",
			"minLength": 1
		},
		"sessionStatusPath": {
			"type": "string",
			"minLength": 1
		},
		"sessionControlPath": {
			"type": "string",
			"minLength": 1
		}
	}
}
